# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/furshield

# JWT: must be at least 32 characters and not a placeholder value.
# The server refuses to start otherwise. Leave it blank here on purpose and
# generate your own, then paste it into your .env:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=30d

# Comma separated list of allowed CORS origins (frontend URLs).
# Defaults to the localhost dev ports when unset.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000